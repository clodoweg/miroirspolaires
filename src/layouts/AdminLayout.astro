---
/**
 * AdminLayout - coque commune à toutes les pages sous /admin.
 *
 * Responsabilité : barre latérale par sections (`AdminSidebar.astro`, alimentée par le registre
 * `src/config/admin-sections.ts`), fil d'Ariane « Admin › Section › Groupe › Page », bandeau de l'admin distant, et
 * remplacement du contenu par une explication quand la page ne fonctionne pas dans le mode courant.
 *
 * Usage :
 *   <AdminLayout active="blog" title="Admin · Blog" description="...">
 *     <BlogEditor client:only="react" />
 *   </AdminLayout>
 *
 * `bleed` : éditeurs pleine largeur, qui ont leur propre barre latérale ; le menu de l'admin s'y replie
 * alors en tête de page, à toutes les largeurs.
 * `heading` : affiche le titre de la page (pour les pages sans panneau qui porte déjà son propre titre).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdminSidebar from "@/components/Admin/AdminSidebar.astro";
import { getRemoteAdminConfig } from "@/lib/admin/auth/config";
import {
    ADMIN_DASHBOARD,
    getAdminPage,
    getAdminPageTitle,
    getAdminSectionOf,
    isAdminPageAvailable,
    type AdminPageId,
} from "@/config/admin-sections";

interface Props {
    title: string;
    description: string;
    active?: AdminPageId;
    /** Contenu pleine largeur (éditeurs avec leur propre mise en page). */
    bleed?: boolean;
    /** Affiche le libellé de la page en titre (pages sans panneau titré). */
    heading?: boolean;
}

const { title, description, active = "dashboard", bleed = false, heading = false } = Astro.props;

const adminAccess = Astro.locals.adminAccess;
const remoteSession = adminAccess?.mode === "remote" ? adminAccess.session : null;
const mode = remoteSession ? "remote" : "local";
const contentBranch = remoteSession ? getRemoteAdminConfig().contentBranch : null;

const page = getAdminPage(active);
const section = getAdminSectionOf(active);
// POURQUOI : une page dont les panneaux exigent le disque ou `spawn` (ou, en local, une page propre à l'admin
// distant) afficherait des erreurs ; on la remplace par une explication.
const isUnavailable = !isAdminPageAvailable(page, mode);
const unavailableMessage =
    mode === "remote"
        ? "Cette page n’est pas encore disponible sur l’admin distant. Elle reste utilisable en npm run dev."
        : "Cette page n’existe que sur l’admin distant (Preview de la branche dev).";
---

<BaseLayout title={title} description={description} hideBreadcrumb hideFooter contentPaddingBottom={false}>
    <aside
        class:list={[
            "border-b border-mp-border bg-mp-bg-secondary",
            !bleed &&
                "admin-sidebar lg:fixed lg:top-navbar lg:bottom-0 lg:left-0 lg:w-64 lg:overflow-y-auto lg:overscroll-contain lg:border-r lg:border-b-0",
        ]}
    >
        <details class:list={["group px-3", !bleed && "lg:hidden"]}>
            <summary class="flex min-h-touch cursor-pointer items-center gap-2 px-3 text-sm text-mp-text-body">
                <span class="font-mono text-xs tracking-wider text-mp-text-muted uppercase">Menu de l'admin</span>
                <span class="text-mp-text-heading">{getAdminPageTitle(page)}</span>
            </summary>
            <AdminSidebar active={active} mode={mode} />
        </details>
        {!bleed && (
            <div class="hidden px-3 lg:block">
                <AdminSidebar active={active} mode={mode} />
            </div>
        )}
    </aside>

    <div class:list={["flex min-w-0 flex-1 flex-col", !bleed && "lg:pl-64"]}>
        <header class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-mp-border px-4 py-3 md:px-8">
            <nav aria-label="Fil d'Ariane" class="flex-1 text-sm text-mp-text-muted">
                <ol class="flex flex-wrap items-center gap-1.5">
                    <li>
                        {active === "dashboard" ? (
                            <span class="text-mp-text-heading">Admin</span>
                        ) : (
                            <a href={ADMIN_DASHBOARD.href} class="mouse:hover:text-mp-accent">
                                Admin
                            </a>
                        )}
                    </li>
                    {section && (
                        <li class="flex items-center gap-1.5">
                            <span aria-hidden="true">›</span>
                            <span>{section.label}</span>
                        </li>
                    )}
                    {page.group && (
                        <li class="flex items-center gap-1.5">
                            <span aria-hidden="true">›</span>
                            <span>{page.group}</span>
                        </li>
                    )}
                    {active !== "dashboard" && (
                        <li class="flex items-center gap-1.5">
                            <span aria-hidden="true">›</span>
                            <span aria-current="page" class="text-mp-text-heading">
                                {page.label}
                            </span>
                        </li>
                    )}
                </ol>
            </nav>
            {remoteSession && (
                <div class="flex flex-wrap items-center gap-3 text-sm">
                    <span class="text-mp-text-muted">
                        Enregistrement = commit sur <code>{contentBranch}</code>
                    </span>
                    <form method="post" action="/api/auth/github/logout" class="flex items-center gap-2">
                        <span class="text-mp-text-muted">@{remoteSession.login}</span>
                        <button type="submit" class="min-h-touch rounded-md px-2 text-mp-accent underline">
                            Se déconnecter
                        </button>
                    </form>
                </div>
            )}
        </header>

        <main class:list={["admin-main", !(bleed && !isUnavailable) && "w-full px-4 py-6 md:px-8"]}>
            {heading && !isUnavailable && (
                <div class="mb-6">
                    <h1 class="font-serif text-2xl font-light text-mp-text-heading md:text-3xl">
                        {getAdminPageTitle(page)}
                    </h1>
                    <p class="text-mp-text-muted">{page.description}</p>
                </div>
            )}
            {isUnavailable ? (
                <p class="rounded-md border border-mp-border px-4 py-6 text-center text-mp-text-muted">
                    {unavailableMessage}
                </p>
            ) : (
                <slot />
            )}
        </main>
    </div>
</BaseLayout>

<style is:global>
    /* POURQUOI : en Tailwind 4, un bloc <style> ne voit les tokens et variantes qu'avec @reference. */
    @reference "../styles/base.css";

    /* Les styles généraux des éditeurs d'administration sont conservés pour assurer l'homogénéité des champs et des barres de défilement. */

    /* Form inputs shared by admin editors. */
    .admin-input {
        @apply w-full rounded-md border border-mp-glass-border bg-mp-ui-black/40 px-2.5 py-2 text-sm text-mp-text-primary;
    }
    .admin-input:focus {
        @apply border-mp-accent/50 outline-hidden;
    }
    .admin-input:disabled {
        @apply opacity-50;
    }

    /* Éditeur WYSIWYG des articles (Tiptap, src/components/Admin/editor/rich/). */
    .rich-editor .is-empty::before {
        @apply pointer-events-none float-left h-0 text-mp-text-muted/60 italic;
        content: attr(data-placeholder);
    }
    .rich-editor .ProseMirror-selectednode > [data-node-view-wrapper] {
        @apply border-mp-accent;
    }
    .rich-editor .ProseMirror-gapcursor::after {
        @apply border-t-2 border-mp-accent;
    }
    .rich-editor a {
        @apply cursor-text;
    }

    /* POURQUOI : la barre latérale ne montre sa barre de défilement (fine) qu'au survol, quand elle déborde. */
    .admin-sidebar {
        scrollbar-width: none;
    }
    .admin-sidebar:hover {
        scrollbar-width: thin;
        scrollbar-color: rgba(212, 180, 131, 0.35) transparent;
    }
    .admin-sidebar::-webkit-scrollbar {
        width: 0;
    }
    .admin-sidebar:hover::-webkit-scrollbar {
        width: 6px;
    }
    .admin-sidebar::-webkit-scrollbar-thumb {
        background-color: rgba(212, 180, 131, 0.35);
        border-radius: 9999px;
    }

    /* Custom scrollbar inside admin shells. */
    .scrollbar-thin {
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
    }
    .scrollbar-thin::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }
    .scrollbar-thin::-webkit-scrollbar-track {
        background: transparent;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb {
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 9999px;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb:hover {
        background-color: rgba(212, 180, 131, 0.4);
    }
</style>
