---
import { ExternalLink } from "lucide-react";
import { fetchWikipedia } from "@/lib/objects/wikipedia";
import Panel from "@/components/UI/Panel.astro";

interface Props {
    description: string;
    candidates: string[];
}

const { description, candidates } = Astro.props;

const summary = candidates.length ? await fetchWikipedia(candidates).catch(() => null) : null;
---

<Panel padding={5} class="mb-6 space-y-3">
    <h2 class="text-sm uppercase tracking-uppercase text-mp-text-secondary">Description</h2>
    <p class="text-mp-text-body text-sm leading-relaxed">{description}</p>
    {summary && (
        <a
            href={summary.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-xs text-mp-accent hover:text-mp-text-link-hover transition-colors no-underline"
        >
            Lire sur Wikipédia
            <ExternalLink className="w-3 h-3" />
        </a>
    )}
</Panel>
