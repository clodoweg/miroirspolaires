---
import { ExternalLink } from "lucide-react";

interface Props {
    objDetails?: any;
    wikiDesc?: any;
}

const { objDetails, wikiDesc } = Astro.props;

// Helper for explicit space-separated thousands: "9 999 999"
const formatNumber = (num: number) => {
    return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, " ");
};
---

{objDetails ? (
    <div>
        <div class="mb-2">
            <h3>À propos de l'objet</h3>
        </div>
        <ul>
            {objDetails.discovery && (
                <li>
                    <strong>Découverte:</strong> {objDetails.discovery}
                </li>
            )}
            {objDetails.object_type && (
                <li>
                    <strong>Type d'objet:</strong> {objDetails.object_type}
                </li>
            )}
            {objDetails.dimensions_ly && (
                <li>
                    <strong>Dimensions:</strong> {formatNumber(objDetails.dimensions_ly)} a.l.
                </li>
            )}
            {objDetails.distance_ly && (
                <li>
                    <strong>Distance:</strong> {formatNumber(objDetails.distance_ly)} a.l.
                </li>
            )}

            {objDetails.apparent_magnitude && (
                <li>
                    <strong>Magnitude apparente:</strong> {objDetails.apparent_magnitude.toLocaleString("fr-FR")}
                </li>
            )}
            {objDetails.apparent_dimensions && (
                <li>
                    <strong>Taille apparente:</strong> {objDetails.apparent_dimensions} arcmin
                </li>
            )}
        </ul>
        {objDetails.source_url && (
            <div class="text-left mt-2">
                <a
                    href={objDetails.source_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs text-mp-text-body/70 hover:text-mp-text-body inline-flex items-center gap-1"
                >
                    Source : Wikipedia <ExternalLink className="w-3 h-3 ml-1" />
                </a>
            </div>
        )}
    </div>
) : wikiDesc && wikiDesc.description ? (
    <div>
        <div class="mb-2">
            <h3>À propos de l'objet</h3>
        </div>
        <div class="desc-content space-y-4 mb-2 text-sm leading-relaxed text-mp-text-body/80">
            {wikiDesc.description.split("\n").map((paragraph: string) => paragraph.trim() && <p>{paragraph.trim()}</p>)}
        </div>
        {wikiDesc.source && (
            <div class="text-left">
                <a
                    href={wikiDesc.source}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs text-mp-text-body/70 hover:text-mp-text-body inline-flex items-center gap-1"
                >
                    Source : Wikipedia <ExternalLink className="w-3 h-3 ml-1" />
                </a>
            </div>
        )}
    </div>
) : null}
