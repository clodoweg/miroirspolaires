---
const pathname = Astro.url.pathname;
const segments = pathname.split("/").filter(Boolean);

interface BreadcrumbItem {
    label: string;
    href?: string;
}

let items: BreadcrumbItem[] = [{ label: "Accueil", href: "/" }];

interface Props {
    lastItemLabel?: string;
    extraItems?: { label: string; href: string }[];
}

const { lastItemLabel, extraItems } = Astro.props;

segments.forEach((segment, index) => {
    // Skip year segments (4 digits)
    if (/^\d{4}$/.test(segment)) return;

    const isLast = index === segments.length - 1;
    const href = `/${segments.slice(0, index + 1).join("/")}`;

    let label = segment.charAt(0).toUpperCase() + segment.slice(1);

    if (isLast && lastItemLabel) {
        label = lastItemLabel;
    }

    // Insert extra items before the last item
    if (isLast && extraItems) {
        extraItems.forEach((item) => {
            items.push(item);
        });
    }

    items.push({
        label,
        href: isLast ? undefined : href,
    });
});
const isSkyMap = pathname.includes("carte-du-ciel");

// Styles specific to Sky Map to handle fixed navbar overlap and dark background
const containerClass = isSkyMap
    ? "w-full relative z-50 transition-all duration-300 bg-mp-ui-black"
    : "w-full relative z-50 transition-all duration-300";
const textColorClass = isSkyMap ? "text-white/80" : "text-mp-text-muted";
const hoverColorClass = isSkyMap ? "hover:text-white" : "hover:text-mp-accent";
const activeColorClass = isSkyMap ? "text-white" : "text-mp-text-heading";
---

<div id="global-breadcrumb" class={containerClass}>
    <div class="max-w-container mx-auto px-4 py-3">
        <nav
            class={`flex items-center justify-center md:justify-center gap-2 text-sm font-sans flex-wrap ${textColorClass}`}
        >
            {items.map((item, index) => (
                <>
                    {index > 0 && <span>/</span>}
                    {item.href ? (
                        <a href={item.href} class={`transition-colors ${hoverColorClass}`}>
                            {item.label}
                        </a>
                    ) : (
                        <span class={activeColorClass}>{item.label}</span>
                    )}
                </>
            ))}
        </nav>
    </div>
</div>
