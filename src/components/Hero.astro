---
import { Image } from "astro:assets";
import { tokens } from "@/styles/design-tokens";
import PrimaryButton from "@/components/UI/PrimaryButton.astro";

import testHero from "@/assets/index/hero.jpg";

interface Props {
    title?: string;
    subtitle?: string;
    ctaText?: string;
    ctaHref?: string;
}

const { title, subtitle, ctaText = "Découvrir", ctaHref = "#content" } = Astro.props;
---

<section class="hero relative flex flex-col justify-end min-h-[calc(100vh-theme('spacing.navbar'))] md:min-h-[calc(100vh-theme('spacing.navbar'))] overflow-hidden">
    {/* Hero background — generated at build time by Astro Image (Sharp),
        served as a responsive picture with proper srcset/sizes so mobile
        downloads ~640px instead of the full-res 1920px. */}
    <div class="absolute inset-0 -z-10 h-full w-full bg-mp-deep-space">
        <Image
            src={testHero}
            alt=""
            widths={[640, 960, 1280, 1920]}
            sizes="100vw"
            quality={70}
            format="webp"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover motion-safe:animate-heroFadeIn duration-extended fill-both"
        />
    </div>

    {/* Overlay to ensure text readability */}
    <div class="absolute inset-0 bg-black/30 pointer-events-none"></div>

    <div class="container-mp relative z-10 pt-12 pb-[calc(14rem+env(safe-area-inset-bottom))] md:pt-16 md:pb-[calc(8rem+env(safe-area-inset-bottom))] lg:pt-20 lg:pb-[calc(10rem+env(safe-area-inset-bottom))]">
        <div class="max-w-4xl mx-auto">
            <img
                src="/images/logo-mp.png"
                alt="Logo Miroirs Polaires"
                width="633"
                height="202"
                class="h-24 md:h-32 w-auto mb-3 md:mb-1 motion-safe:opacity-0 motion-safe:animate-heroFadeIn mx-auto"
                style={`animation-delay: 0ms;`}
            />
            {title && (
                <h1
                    class="font-serif font-light mb-4 md:mb-6 motion-safe:opacity-0 motion-safe:animate-heroFadeIn text-balance text-center text-h1-mobile md:text-h2-tablet lg:text-h1-desktop text-white leading-tight"
                    style={`animation-delay: ${tokens.transitions.micro};`}
                >
                    {title}
                </h1>
            )}
            {subtitle && (
                <p
                    class="text-h3-mobile md:text-h3-tablet lg:text-h3-desktop text-white/90 max-w-2xl mb-8 motion-safe:opacity-0 motion-safe:animate-heroFadeIn text-pretty leading-relaxed text-center mx-auto"
                    style={`animation-delay: ${tokens.transitions.base};`}
                >
                    {subtitle}
                </p>
            )}
            <div
                class="motion-safe:opacity-0 motion-safe:animate-heroFadeIn flex justify-center mt-8 md:mt-8"
                style={`animation-delay: ${tokens.transitions.slow};`}
            >
                <PrimaryButton
                    href={ctaHref}
                    label={ctaText}
                    variant="glow"
                    class="text-white! border-white/60! hover:border-mp-accent! hover:text-white!"
                />
            </div>
        </div>
    </div>
</section>
