---
/**
 * GalleryGrid - Photo collection with grid / list dual rendering.
 *
 * Each photo wrapper carries the filter-relevant data attributes
 * (consumed by UniversalFilterBar) AND the values needed for client-side
 * sorting in list view (data-title, data-year, …). The list view is styled
 * using the unified glassmorphism card-row system matching EntryListView and
 * all tool viewers (Exoplanets, Asteroids, Comets, etc.).
 */
import { ArrowUpDown, ArrowUp, ArrowDown, ChevronDown } from "lucide-react";
import GalleryCard from "../UI/GalleryCard.astro";
import PhotoMetadata from "./PhotoMetadata.astro";
import type { Photo } from "@/lib/photos";
import type { ImageMetadata } from "astro";
import { resolveImage, getLocalImageDimensions, getWebImageSet, buildOptimizedUrl } from "@/utils/imageService";
import { EAGER_LOAD_COUNT, GALLERY_FULL_RENDER_COUNT } from "@/utils/constants";
import { formatDateShort } from "@/lib/format";
import AppImage from "@/components/UI/AppImage.astro";
import StaticSkyMap from "@/components/SkyMap/StaticSkyMap";
import TechnicalDetails from "@/components/astrophotography/TechnicalDetails.astro";
import ActionButtons from "@/components/astrophotography/ActionButtons.astro";

import wikipediaDataJson from "@/data/wikipedia.json";
import astroDetailsDataJson from "@/data/astro_details.json";
import { getAnnotationVersion } from "@/lib/annotation-version";

const wikipediaData = wikipediaDataJson as Record<string, any>;
const astroDetailsData = astroDetailsDataJson as Record<string, any>;

interface Props {
    photos: Photo[];
    showMetadata?: boolean;
}

const { photos, showMetadata = true } = Astro.props;

const getSrcUrl = (resolved: ImageMetadata | string | undefined | null) => {
    if (!resolved) return undefined;
    if (typeof resolved === "string") return resolved;
    return resolved.src;
};
---

<div class="max-w-container mx-auto px-4 pb-16">
    <div
        id="gallery-grid"
        data-view="grid"
        class="group grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 data-[view=list]:grid data-[view=list]:grid-cols-1 nav:data-[view=list]:grid-cols-[max-content_minmax(0,1fr)_max-content_max-content_max-content_max-content_max-content_max-content] data-[view=list]:gap-y-3"
    >
        {/* Table header — only shown in list mode */}
        <div class="hidden group-data-[view=list]:hidden nav:group-data-[view=list]:grid col-span-full grid-cols-subgrid gap-4 px-6 py-3 border border-mp-glass-border bg-mp-glass-solid/50 rounded-xl text-xs font-semibold text-mp-text-muted uppercase tracking-wider items-center select-none">
            <div>Aperçu</div>
            <div
                class="cursor-pointer hover:text-mp-text-primary select-none whitespace-nowrap text-left"
                data-sort-key="title"
            >
                <span class="inline-flex items-center gap-1">
                    Titre
                    <span class="sort-icon-neutral inline-flex">
                        <ArrowUpDown className="w-3 h-3 text-mp-text-muted/40" />
                    </span>
                    <span class="sort-icon-asc hidden text-mp-accent">
                        <ArrowUp className="w-3 h-3" />
                    </span>
                    <span class="sort-icon-desc hidden text-mp-accent">
                        <ArrowDown className="w-3 h-3" />
                    </span>
                </span>
            </div>
            <div
                class="text-left cursor-pointer hover:text-mp-text-primary select-none whitespace-nowrap"
                data-sort-key="type"
            >
                <span class="inline-flex items-center gap-1">
                    Type
                    <span class="sort-icon-neutral inline-flex">
                        <ArrowUpDown className="w-3 h-3 text-mp-text-muted/40" />
                    </span>
                    <span class="sort-icon-asc hidden text-mp-accent">
                        <ArrowUp className="w-3 h-3" />
                    </span>
                    <span class="sort-icon-desc hidden text-mp-accent">
                        <ArrowDown className="w-3 h-3" />
                    </span>
                </span>
            </div>
            <div
                class="text-left cursor-pointer hover:text-mp-text-primary select-none whitespace-nowrap"
                data-sort-key="constellation"
            >
                <span class="inline-flex items-center gap-1">
                    Constellation
                    <span class="sort-icon-neutral inline-flex">
                        <ArrowUpDown className="w-3 h-3 text-mp-text-muted/40" />
                    </span>
                    <span class="sort-icon-asc hidden text-mp-accent">
                        <ArrowUp className="w-3 h-3" />
                    </span>
                    <span class="sort-icon-desc hidden text-mp-accent">
                        <ArrowDown className="w-3 h-3" />
                    </span>
                </span>
            </div>
            <div
                class="text-left cursor-pointer hover:text-mp-text-primary select-none whitespace-nowrap"
                data-sort-key="integration"
                data-sort-numeric="1"
            >
                <span class="inline-flex items-center gap-1">
                    Intégration
                    <span class="sort-icon-neutral inline-flex">
                        <ArrowUpDown className="w-3 h-3 text-mp-text-muted/40" />
                    </span>
                    <span class="sort-icon-asc hidden text-mp-accent">
                        <ArrowUp className="w-3 h-3" />
                    </span>
                    <span class="sort-icon-desc hidden text-mp-accent">
                        <ArrowDown className="w-3 h-3" />
                    </span>
                </span>
            </div>
            <div
                class="hidden xl:block text-left cursor-pointer hover:text-mp-text-primary select-none whitespace-nowrap"
                data-sort-key="location"
            >
                <span class="inline-flex items-center gap-1">
                    Lieu
                    <span class="sort-icon-neutral inline-flex">
                        <ArrowUpDown className="w-3 h-3 text-mp-text-muted/40" />
                    </span>
                    <span class="sort-icon-asc hidden text-mp-accent">
                        <ArrowUp className="w-3 h-3" />
                    </span>
                    <span class="sort-icon-desc hidden text-mp-accent">
                        <ArrowDown className="w-3 h-3" />
                    </span>
                </span>
            </div>
            <div
                class="hidden nav:block text-left cursor-pointer hover:text-mp-text-primary select-none whitespace-nowrap"
                data-sort-key="date"
            >
                <span class="inline-flex items-center gap-1">
                    Date
                    <span class="sort-icon-neutral inline-flex">
                        <ArrowUpDown className="w-3 h-3 text-mp-text-muted/40" />
                    </span>
                    <span class="sort-icon-asc hidden text-mp-accent">
                        <ArrowUp className="w-3 h-3" />
                    </span>
                    <span class="sort-icon-desc hidden text-mp-accent">
                        <ArrowDown className="w-3 h-3" />
                    </span>
                </span>
            </div>
            <div></div>
        </div>

        {photos.map((photo, index) => {
            const imagePath = `../../assets/astrophotographies/${photo.imagePath}`;
            const resolvedImage = resolveImage(imagePath, true, photo.version);
            const resolvedFull = resolveImage(imagePath, false, photo.version);
            const thumbUrl = typeof resolvedImage === "string" ? resolvedImage : resolvedImage?.src;
            const fullImageUrl = getSrcUrl(resolvedFull);

            const annotationRelativePath = photo.annotationPath
                ? `../../assets/astrophotographies/${photo.annotationPath}`
                : null;
            const resolvedAnnotation = annotationRelativePath
                ? resolveImage(annotationRelativePath, false, getAnnotationVersion(photo.id) ?? photo.version)
                : null;
            const annotationUrl = getSrcUrl(resolvedAnnotation);

            const mainDims = getLocalImageDimensions(imagePath) || {
                width: 3,
                height: 2,
            };
            const wikiDesc = wikipediaData[String(photo.id)] || wikipediaData[Number(photo.id)] || null;
            const objDetails = astroDetailsData[String(photo.id)] || astroDetailsData[Number(photo.id)] || null;

            const uploadedDate = photo.uploaded ? new Date(photo.uploaded) : null;
            const dateDisplay =
                uploadedDate && !Number.isNaN(uploadedDate.getTime()) ? formatDateShort(uploadedDate) : "";
            const dateSortKey = uploadedDate && !Number.isNaN(uploadedDate.getTime()) ? uploadedDate.toISOString() : "";

            const isLazyCard = index >= GALLERY_FULL_RENDER_COUNT;
            // POURQUOI: thumbUrl pointe déjà vers la vignette mini pré-générée (~100–300 Ko).
            // L'utiliser directement évite de solliciter le Worker Cloudflare Images dont le
            // quota CPU est limité à 10 ms (ce qui générait des erreurs HTTP 503 lors des rafales
            // de requêtes au défilement).
            // POURQUOI : quand la mini/ a des versions web 400/800/1200 px sur R2, les cartes et la
            // vignette de la vue liste les utilisent (fichiers statiques, sans worker) au lieu de la
            // mini/ de 1 600 px, soit 3 à 10 fois moins d'octets.
            const webImageSet = thumbUrl ? getWebImageSet(thumbUrl) : null;
            const cardImageUrl = webImageSet && thumbUrl ? buildOptimizedUrl(thumbUrl, { width: 800 }) : thumbUrl;
            const listThumbUrl = webImageSet && thumbUrl ? buildOptimizedUrl(thumbUrl, { width: 400 }) : thumbUrl;
            const lazyThumbUrl = isLazyCard && cardImageUrl ? cardImageUrl : "";
            const detailHref = `/astrophotographies/${photo.slug}`;

            return (
                <div
                    data-type={photo.type}
                    data-constellation={photo.constellation}
                    data-observatories={photo.observatories.join(";")}
                    data-location={photo.locations}
                    data-telescope={photo.telescope}
                    data-camera={photo.camera}
                    data-year={photo.year}
                    data-title={photo.title}
                    data-date={dateSortKey}
                    data-integration={photo.integrationSeconds ?? 0}
                    data-delay={Math.min(index * 30, 300)}
                    class:list={[
                        index < EAGER_LOAD_COUNT ? "" : "js-reveal reveal-hidden",
                        "group-data-[view=list]:block nav:group-data-[view=list]:grid group-data-[view=list]:col-span-full group-data-[view=list]:grid-cols-subgrid",
                    ]}
                >
                    {resolvedImage ? (
                        <>
                            {/* Grid card (default view) */}
                            <div class="group-data-[view=list]:hidden">
                                {isLazyCard ? (
                                    <a
                                        href={detailHref}
                                        class="block group relative rounded-xl"
                                        data-lazy-card
                                        data-lazy-src={lazyThumbUrl}
                                        data-lazy-srcset={webImageSet?.srcset}
                                        data-lazy-alt={photo.title}
                                        data-lazy-width={mainDims.width}
                                        data-lazy-height={mainDims.height}
                                    >
                                        <div class="relative overflow-hidden rounded-xl aspect-photo bg-mp-glass-bg" />
                                        <div class="mt-3 md:mt-4 space-y-2">
                                            <h4 class="font-serif font-light tracking-wide leading-tight text-mp-text-heading text-lg md:text-xl transition-colors duration-300 group-hover:text-mp-accent">
                                                {photo.title}
                                            </h4>
                                            {showMetadata && (
                                                <div class="flex flex-wrap items-center gap-2 text-xs font-sans uppercase tracking-wider text-mp-text-muted">
                                                    <PhotoMetadata photo={photo} showSeparators={false} />
                                                </div>
                                            )}
                                        </div>
                                    </a>
                                ) : (
                                    <GalleryCard
                                        title={photo.title}
                                        image={resolvedImage}
                                        href={detailHref}
                                        sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw"
                                        mobileVariant="overlay"
                                        overlayGradient={false}
                                        cardStyle="stacked"
                                        loading={index < EAGER_LOAD_COUNT ? "eager" : "lazy"}
                                    >
                                        {showMetadata && (
                                            <PhotoMetadata slot="metadata" photo={photo} showSeparators={false} />
                                        )}
                                    </GalleryCard>
                                )}
                            </div>

                            {/* List row card (table view matching tools style) */}
                            <div class="hidden group-data-[view=list]:block nav:group-data-[view=list]:grid col-span-full nav:grid-cols-subgrid row-container bg-mp-glass-bg border border-mp-glass-border rounded-xl transition-all duration-slow overflow-hidden">
                                <button
                                    type="button"
                                    data-toggle-row
                                    class="grid grid-cols-[max-content_minmax(0,1fr)_max-content] nav:grid-cols-subgrid nav:col-span-full gap-3 nav:gap-4 w-full text-left px-3.5 md:px-6 py-2.5 md:py-3.5 items-center hover:bg-mp-glass-solid/40 transition-colors group/row cursor-pointer select-none bg-transparent border-0"
                                >
                                    {/* Aperçu thumbnail */}
                                    <div class="w-12 h-8 nav:w-16 nav:h-9 rounded-md overflow-hidden bg-mp-bg-secondary border border-mp-glass-border flex items-center justify-center shrink-0">
                                        {listThumbUrl && (
                                            <img
                                                data-lazy-list-src={listThumbUrl}
                                                alt=""
                                                loading="lazy"
                                                decoding="async"
                                                class="w-full h-full object-cover opacity-0 transition-opacity duration-300"
                                            />
                                        )}
                                    </div>

                                    {/* Titre (absorbe TOUT l'espace disponible restant) */}
                                    <div class="min-w-0 text-left">
                                        <h4 class="font-serif font-light text-mp-text-heading text-sm nav:text-base group-hover/row:text-mp-accent transition-colors truncate text-left">
                                            {photo.title}
                                        </h4>
                                    </div>

                                    {/* Type */}
                                    <div class="hidden nav:block text-left whitespace-nowrap">
                                        <span
                                            class={`text-[9px] px-1.5 py-0.5 rounded border select-none uppercase font-sans font-medium tracking-wider inline-block ${
                                                /nébuleus/i.test(photo.type ?? "")
                                                    ? "border-rose-500/40 bg-rose-500/15 text-rose-400"
                                                    : /galax/i.test(photo.type ?? "")
                                                      ? "border-purple-500/40 bg-purple-500/15 text-purple-400"
                                                      : /amas/i.test(photo.type ?? "")
                                                        ? "border-amber-500/40 bg-amber-500/15 text-amber-400"
                                                        : /solaire|lune|soleil|planète/i.test(photo.type ?? "")
                                                          ? "border-blue-500/40 bg-blue-500/15 text-blue-400"
                                                          : "border-teal-500/40 bg-teal-500/15 text-teal-400"
                                            }`}
                                        >
                                            {photo.type}
                                        </span>
                                    </div>

                                    {/* Constellation */}
                                    <div class="hidden nav:block text-left text-xs text-mp-text-muted font-sans whitespace-nowrap">
                                        {photo.constellation}
                                    </div>

                                    {/* Intégration */}
                                    <div class="hidden nav:block text-left text-xs text-mp-accent font-mono font-medium whitespace-nowrap">
                                        {photo.integrationTime || "—"}
                                    </div>

                                    {/* Lieu */}
                                    <div class="hidden xl:block text-left text-xs text-mp-text-muted font-sans whitespace-nowrap">
                                        {photo.locations}
                                    </div>

                                    {/* Date */}
                                    <div class="hidden nav:block text-left text-xs text-mp-text-muted font-sans whitespace-nowrap">
                                        {dateDisplay}
                                    </div>

                                    {/* Bouton chevron de détails */}
                                    <div class="flex items-center justify-end text-right">
                                        <ChevronDown className="w-5 h-5 text-mp-text-muted group-hover/row:text-mp-accent transition-transform duration-300 row-chevron" />
                                    </div>
                                </button>

                                {/* Tiroir détaillé dépliant (contenu exact de la fiche complète) */}
                                <div class="hidden col-span-full row-drawer border-t border-mp-glass-border bg-mp-bg-secondary/60 p-4 md:p-8 space-y-6 relative min-h-[220px]">
                                    {/* Spinner de chargement cosmique style AstronomicalLoader */}
                                    <div class="drawer-loader hidden flex-col items-center justify-center py-12 px-6 rounded-2xl border border-mp-glass-border bg-mp-glass-bg/80 backdrop-blur-md text-center space-y-4 my-2">
                                        <div class="relative w-16 h-16 flex items-center justify-center">
                                            <div
                                                class="absolute inset-0 rounded-full border border-mp-accent/20 animate-ping"
                                                style="animation-duration: 2.5s;"
                                            ></div>
                                            <svg
                                                class="absolute inset-0 w-full h-full animate-spin"
                                                style="animation-duration: 3s;"
                                                viewBox="0 0 100 100"
                                                aria-hidden="true"
                                            >
                                                <circle
                                                    cx="50"
                                                    cy="50"
                                                    r="45"
                                                    fill="none"
                                                    stroke="rgba(212, 180, 131, 0.1)"
                                                    stroke-width="2"
                                                ></circle>
                                                <line
                                                    x1="50"
                                                    y1="50"
                                                    x2="50"
                                                    y2="5"
                                                    stroke="url(#drawerScannerGrad)"
                                                    stroke-width="3"
                                                    stroke-linecap="round"
                                                ></line>
                                                <defs>
                                                    <linearGradient
                                                        id="drawerScannerGrad"
                                                        x1="0%"
                                                        y1="0%"
                                                        x2="0%"
                                                        y2="100%"
                                                    >
                                                        <stop offset="0%" stop-color="#D4B483"></stop>
                                                        <stop offset="100%" stop-color="transparent"></stop>
                                                    </linearGradient>
                                                </defs>
                                            </svg>
                                            <div class="relative w-6 h-6 rounded-full bg-mp-accent shadow-[0_0_15px_#D4B483] flex items-center justify-center animate-pulse">
                                                <svg
                                                    class="w-3 h-3 text-mp-ui-black"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2.5"
                                                >
                                                    <circle cx="12" cy="12" r="4"></circle>
                                                    <path d="M12 2v2M12 20v2M2 12h2M20 12h2"></path>
                                                </svg>
                                            </div>
                                        </div>
                                        <div class="space-y-1">
                                            <p class="text-sm font-serif font-light text-mp-text-heading tracking-wide">
                                                Chargement des données astrophotographiques...
                                            </p>
                                            <p class="text-xs text-mp-text-muted">
                                                Rendu de la vue détaillée et des cartes célestes
                                            </p>
                                        </div>
                                    </div>

                                    <div class="drawer-content transition-opacity duration-300">
                                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                                            {/* Colonne principale (Image, boutons d'action, carte interactive) */}
                                            <div class="lg:col-span-8 space-y-6">
                                                {/* Image principale & calque d'annotation */}
                                                <div
                                                    class={`bg-mp-bg-secondary rounded-xl overflow-hidden shadow-2xl relative group image-container-row ${annotationUrl ? "cursor-pointer" : ""}`}
                                                    data-has-annotation={annotationUrl ? "true" : "false"}
                                                >
                                                    {/* WARNING: jamais l'original (resolvedFull) : le worker le renvoie entier,
                                                        91,5 Mo mesurés à l'ouverture d'une ligne. La mini/ et ses versions web
                                                        suffisent pour 66vw, comme sur la fiche de la photo. */}
                                                    {resolvedImage ? (
                                                        <AppImage
                                                            src={resolvedImage}
                                                            alt={photo.title}
                                                            class="w-full h-auto rounded-xl"
                                                            loading="lazy"
                                                            width={mainDims.width}
                                                            height={mainDims.height}
                                                            sizes="(max-width: 1400px) 66vw, 933px"
                                                        />
                                                    ) : (
                                                        <div class="bg-mp-bg-secondary w-full aspect-photo flex items-center justify-center text-mp-text-muted">
                                                            Image non trouvée
                                                        </div>
                                                    )}

                                                    {/* Annotation Overlay Layer */}
                                                    {/* POURQUOI <img> : SVG servi depuis R2 avec sa version (?v=),
                                                        sans worker ni srcset (voir la page de la photo). */}
                                                    {annotationUrl && (
                                                        <img
                                                            src={annotationUrl}
                                                            alt={`Annotation pour ${photo.title}`}
                                                            class="annotation-layer absolute inset-0 w-full h-full object-contain pointer-events-none opacity-0 transition-opacity duration-300 z-10"
                                                            width={1920}
                                                            height={1280}
                                                            loading="lazy"
                                                            decoding="async"
                                                            fetchpriority="low"
                                                        />
                                                    )}
                                                </div>

                                                {/* Boutons d'action (Télécharger, AstroBin, Objets, etc.) */}
                                                <div class="space-y-4">
                                                    <ActionButtons
                                                        photo={photo}
                                                        mainImageUrl={fullImageUrl}
                                                        annotationUrl={annotationUrl}
                                                    />
                                                </div>

                                                {/* Carte du ciel interactive StaticSkyMap */}
                                                {photo.raVal != null && photo.decVal != null && (
                                                    <a
                                                        href={`/carte-du-ciel?slug=${photo.slug}`}
                                                        class="block group relative cursor-pointer"
                                                        title="Voir sur la carte interactive"
                                                    >
                                                        <div
                                                            class="aspect-photo md:aspect-2/1 bg-mp-bg-secondary rounded-xl overflow-hidden shadow-md transition-transform duration-300 group-hover:scale-[1.01]"
                                                            style="content-visibility: auto; contain-intrinsic-size: auto 400px;"
                                                        >
                                                            <StaticSkyMap
                                                                client:visible
                                                                raVal={photo.raVal}
                                                                decVal={photo.decVal}
                                                                radius={photo.radius}
                                                                fieldSize={photo.fieldSize}
                                                                title={photo.title}
                                                            />
                                                        </div>
                                                    </a>
                                                )}
                                            </div>

                                            {/* Colonne latérale (Fiche Technique, Description Wikipedia, Matériel & Acquisition) */}
                                            <div class="lg:col-span-4 h-fit">
                                                <TechnicalDetails
                                                    photo={photo}
                                                    objDetails={objDetails}
                                                    wikiDesc={wikiDesc}
                                                />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </>
                    ) : (
                        <div class="w-full aspect-photo rounded-xl flex items-center justify-center bg-mp-bg-secondary text-mp-text-muted">
                            Image non disponible
                        </div>
                    )}
                </div>
            );
        })}
    </div>
</div>

<script>
    // Client-side table sort for the gallery list view. Mirrors the
    // none → asc → desc → none cycle used by EntryListView on the
    // catalogue pages, and reorders the same DOM nodes that the filter
    // bar sets `style.display` on — so sort and filter stack cleanly.
    (() => {
        const grid = document.getElementById("gallery-grid");
        if (!grid) return;

        const photoRows = Array.from(grid.querySelectorAll<HTMLElement>(":scope > [data-title]"));
        const originalOrder = photoRows.slice();
        let sortState: { key: string; dir: "asc" | "desc" } | null = null;

        function getValue(row: HTMLElement, key: string, numeric: boolean) {
            const raw = row.getAttribute(`data-${key}`) ?? "";
            if (numeric) {
                const n = parseFloat(raw);
                return Number.isFinite(n) ? n : Number.POSITIVE_INFINITY;
            }
            if (key === "observatories") {
                return (raw.split(";")[0] ?? "").trim().toLowerCase();
            }
            return raw.toLowerCase();
        }

        function applySort() {
            const ordered = sortState
                ? [...photoRows].sort((a, b) => {
                      const numeric =
                          grid!
                              .querySelector(`[data-sort-key="${sortState!.key}"]`)
                              ?.getAttribute("data-sort-numeric") === "1";
                      const va = getValue(a, sortState!.key, numeric);
                      const vb = getValue(b, sortState!.key, numeric);
                      let cmp: number;
                      if (typeof va === "number" && typeof vb === "number") {
                          cmp = va - vb;
                      } else {
                          cmp = String(va).localeCompare(String(vb), "fr", {
                              numeric: true,
                          });
                      }
                      return sortState!.dir === "desc" ? -cmp : cmp;
                  })
                : originalOrder;
            // Re-append in the desired order. appendChild on an already-attached
            // node moves it, preserving event listeners.
            ordered.forEach((row) => grid!.appendChild(row));
        }

        function refreshIcons() {
            grid!.querySelectorAll<HTMLElement>("[data-sort-key]").forEach((th) => {
                const key = th.getAttribute("data-sort-key");
                const neutral = th.querySelector<HTMLElement>(".sort-icon-neutral");
                const asc = th.querySelector<HTMLElement>(".sort-icon-asc");
                const desc = th.querySelector<HTMLElement>(".sort-icon-desc");
                const active = sortState && sortState.key === key;
                neutral?.classList.toggle("hidden", !!active);
                asc?.classList.toggle("hidden", !(active && sortState!.dir === "asc"));
                desc?.classList.toggle("hidden", !(active && sortState!.dir === "desc"));
            });
        }

        grid.querySelectorAll<HTMLElement>("[data-sort-key]").forEach((th) => {
            th.addEventListener("click", () => {
                const key = th.getAttribute("data-sort-key")!;
                if (!sortState || sortState.key !== key) {
                    sortState = { key, dir: "asc" };
                } else if (sortState.dir === "asc") {
                    sortState = { key, dir: "desc" };
                } else {
                    sortState = null;
                }
                applySort();
                refreshIcons();
            });
        });

        // Accordion drawer expand / collapse toggle for list view rows
        grid.addEventListener("click", (e) => {
            const toggleBtn = (e.target as HTMLElement).closest<HTMLElement>("[data-toggle-row]");
            if (!toggleBtn) return;

            const rowContainer = toggleBtn.closest<HTMLElement>(".row-container");
            if (!rowContainer) return;

            const drawer = rowContainer.querySelector<HTMLElement>(".row-drawer");
            const chevron = rowContainer.querySelector<HTMLElement>(".row-chevron");
            if (!drawer) return;

            const isExpanded = !drawer.classList.contains("hidden");
            if (isExpanded) {
                drawer.classList.add("hidden");
                chevron?.classList.remove("rotate-180");
                rowContainer.classList.remove("bg-mp-glass-solid/50");
            } else {
                drawer.classList.remove("hidden");
                chevron?.classList.add("rotate-180");
                rowContainer.classList.add("bg-mp-glass-solid/50");

                // Affichage du spinner de chargement si l'image principale du tiroir est en cours de téléchargement
                const loader = drawer.querySelector<HTMLElement>(".drawer-loader");
                const drawerContent = drawer.querySelector<HTMLElement>(".drawer-content");
                if (loader && drawerContent) {
                    const mainImg = drawerContent.querySelector<HTMLImageElement>(".image-container-row img");

                    const hideSpinner = () => {
                        loader.classList.add("hidden");
                        loader.classList.remove("flex");
                        drawerContent.classList.remove("opacity-0");
                    };

                    if (mainImg && !mainImg.complete) {
                        loader.classList.remove("hidden");
                        loader.classList.add("flex");
                        drawerContent.classList.add("opacity-0");

                        mainImg.addEventListener("load", hideSpinner, { once: true });
                        mainImg.addEventListener("error", hideSpinner, { once: true });

                        // Sécurité de secours au cas où le chargement prendrait plus de 2.5 secondes
                        setTimeout(hideSpinner, 2500);
                    } else {
                        hideSpinner();
                    }
                }
            }
        });

        // Toggle annotation overlay on button click or main image click
        grid.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;

            const toggleBtn = target.closest<HTMLElement>("#toggle-annotation, [data-toggle-annotation]");
            const imageContainer = target.closest<HTMLElement>(".image-container-row[data-has-annotation='true']");

            if (toggleBtn || imageContainer) {
                const rowContainer =
                    target.closest<HTMLElement>(".row-container") || target.closest<HTMLElement>("[data-title]");
                if (!rowContainer) return;

                const annotationLayer = rowContainer.querySelector<HTMLElement>(".annotation-layer");
                if (!annotationLayer) return;

                if (toggleBtn && e) {
                    e.preventDefault();
                    e.stopPropagation();
                }

                const isVisible = annotationLayer.classList.contains("opacity-100");
                const shouldShow = !isVisible;

                if (shouldShow) {
                    annotationLayer.classList.remove("opacity-0");
                    annotationLayer.classList.add("opacity-100");
                } else {
                    annotationLayer.classList.remove("opacity-100");
                    annotationLayer.classList.add("opacity-0");
                }

                if (toggleBtn) {
                    const btnText = toggleBtn.querySelector<HTMLElement>("#annotation-btn-text");
                    if (btnText) {
                        btnText.textContent = shouldShow ? "Masquer annotations" : "Annotations";
                    }
                    toggleBtn.classList.toggle("bg-mp-accent/20", shouldShow);
                    toggleBtn.classList.toggle("text-mp-accent", shouldShow);
                    toggleBtn.classList.toggle("border-mp-accent", shouldShow);
                }
            }
        });
    })();

    // Lazy-hydrate gallery placeholders.
    //
    // Cards past GALLERY_FULL_RENDER_COUNT are rendered as empty skeletons
    // carrying the same data-* attributes as full cards (so the filter bar
    // still finds them). On scroll, when one approaches the viewport, we
    // inject a single <img> (no <picture>): the R2 web versions as srcset when
    // they exist, otherwise the mini/. 200 px rootMargin gives the browser a head start.
    (() => {
        const lazyCardElements = document.querySelectorAll<HTMLElement>("[data-lazy-card]");
        if (!lazyCardElements.length || typeof IntersectionObserver === "undefined") {
            lazyCardElements.forEach(hydrateGalleryCard);
            return;
        }

        /**
         * Hydrate a single gallery card by injecting its actual img element.
         * Safe to call multiple times (returns existing img if already hydrated).
         *
         * @param galleryCardElement - The wrapper element representing the card placeholder
         * @returns The injected or existing HTMLImageElement, or null if invalid
         */
        function hydrateGalleryCard(galleryCardElement: HTMLElement): HTMLImageElement | null {
            const isAlreadyHydrated = !galleryCardElement.hasAttribute("data-lazy-card");
            if (isAlreadyHydrated) {
                return galleryCardElement.querySelector<HTMLImageElement>("img");
            }

            const imageSourceUrl = galleryCardElement.getAttribute("data-lazy-src");
            const imageSourceSet = galleryCardElement.getAttribute("data-lazy-srcset");
            const alternativeText = galleryCardElement.getAttribute("data-lazy-alt") || "";
            const width = galleryCardElement.getAttribute("data-lazy-width");
            const height = galleryCardElement.getAttribute("data-lazy-height");
            if (!imageSourceUrl) return null;

            const imageContainerBox = galleryCardElement.querySelector<HTMLElement>(":scope > div");
            if (!imageContainerBox) return null;

            const imgElement = document.createElement("img");
            // POURQUOI: loading="lazy" et decoding="async" doivent impérativement être
            // assignés AVANT imgElement.src pour que le navigateur n'enclenche pas de fetch immédiat.
            imgElement.loading = "lazy";
            imgElement.decoding = "async";
            imgElement.alt = alternativeText;
            if (width) imgElement.setAttribute("width", width);
            if (height) imgElement.setAttribute("height", height);
            imgElement.className =
                "w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-card-hover";

            // POURQUOI: Si une coupure réseau transitoire survient lors d'un défilement rapide,
            // on retente le chargement de la vignette mini avec un paramètre d'invalidation (2 essais).
            // Ne JAMAIS basculer sur l'image raw haute résolution (qui pèse 25 à 40 Mo et asphyxierait
            // le pool de connexions HTTP du navigateur).
            let retryAttempts = 0;
            imgElement.onerror = () => {
                if (retryAttempts < 2) {
                    retryAttempts++;
                    // POURQUOI : avec un srcset, le navigateur ignore un changement de src.
                    imgElement.removeAttribute("srcset");
                    setTimeout(() => {
                        const separator = imageSourceUrl.includes("?") ? "&" : "?";
                        imgElement.src = `${imageSourceUrl}${separator}retry=${retryAttempts}_${Date.now()}`;
                    }, 400 * retryAttempts);
                } else {
                    imgElement.onerror = null;
                }
            };

            if (imageSourceSet) {
                imgElement.sizes = "(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw";
                imgElement.srcset = imageSourceSet;
            }
            imgElement.src = imageSourceUrl;
            imageContainerBox.appendChild(imgElement);
            galleryCardElement.removeAttribute("data-lazy-card");
            return imgElement;
        }

        const cardIntersectionObserver = new IntersectionObserver(
            (observedEntries) => {
                for (const entry of observedEntries) {
                    if (entry.isIntersecting) {
                        hydrateGalleryCard(entry.target as HTMLElement);
                        cardIntersectionObserver.unobserve(entry.target);
                    }
                }
            },
            { rootMargin: "350px" },
        );

        lazyCardElements.forEach((el) => cardIntersectionObserver.observe(el));
    })();

    // Lazy-load list view thumbnails.
    //
    // POURQUOI : Les balises <img> de la vue liste cachée provoquent des requêtes inutiles
    // de la part du preload scanner des navigateurs si elles possèdent un attribut `src`.
    // L'utilisation de `data-lazy-list-src` combinée à cet IntersectionObserver permet de
    // retarder le chargement jusqu'à ce que la ligne de tableau devienne visible (lors du
    // passage en vue "list" et du scroll).
    (() => {
        const lazyListImages = document.querySelectorAll<HTMLImageElement>("img[data-lazy-list-src]");
        if (!lazyListImages.length || typeof IntersectionObserver === "undefined") {
            lazyListImages.forEach(hydrateListImage);
            return;
        }

        function hydrateListImage(imageElement: HTMLImageElement) {
            const sourceUrl = imageElement.getAttribute("data-lazy-list-src");
            if (!sourceUrl) return;
            imageElement.src = sourceUrl;
            imageElement.removeAttribute("data-lazy-list-src");
            imageElement.classList.remove("opacity-0");
        }

        const listImageObserver = new IntersectionObserver(
            (observedEntries) => {
                for (const entry of observedEntries) {
                    if (entry.isIntersecting) {
                        hydrateListImage(entry.target as HTMLImageElement);
                        listImageObserver.unobserve(entry.target);
                    }
                }
            },
            { rootMargin: "100px" },
        );

        lazyListImages.forEach((imageElement) => listImageObserver.observe(imageElement));
    })();
</script>
