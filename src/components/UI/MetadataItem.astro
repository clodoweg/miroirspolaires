---
import {
    Calendar,
    Tag,
    Clock,
    Compass,
    Star,
    Telescope,
    Camera,
    Hourglass,
    Globe,
    Film,
    MapPin,
    SatelliteDish,
    Settings,
    Mountain,
    FileText,
    Cpu,
    Snowflake,
    Leaf,
    Sun,
    Wind,
} from "lucide-react";

interface Props {
    icon?: string;
    label?: string | number;
    class?: string;
}

const { icon, label, class: className } = Astro.props;

// Map icon strings to Lucide components
const IconMap: Record<string, any> = {
    calendar: Calendar,
    tag: Tag,
    clock: Clock,
    compass: Compass,
    star: Star,
    telescope: Telescope,
    camera: Camera,
    hourglass: Hourglass,
    globe: Globe,
    film: Film,
    pin: MapPin,
    dish: SatelliteDish,
    cog: Settings,
    mountain: Mountain,
    "file-text": FileText,
    cpu: Cpu,
    snowflake: Snowflake,
    leaf: Leaf,
    sun: Sun,
    wind: Wind,
};

const IconComponent = icon ? IconMap[icon] : null;
---

{label && (
    <span class:list={["flex items-center gap-1.5 px-2 py-0.5 rounded-full backdrop-blur-xs", className]}>
        {IconComponent ? (
            <IconComponent className="w-3.5 h-3.5 opacity-70" strokeWidth={1.5} />
        ) : icon ? (
            <span>{icon}</span>
        ) : null}
        <slot>{label}</slot>
    </span>
)}
