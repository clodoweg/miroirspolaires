---
/**
 * GalleryCard - Unified card component for image grids
 *
 * Behavior:
 * - Desktop: Title below image, metadata appears on hover (overlay)
 * - Mobile: Title and metadata below image
 */
import type { ImageMetadata } from "astro";
import AppImage from "./AppImage.astro";

interface Props {
    title: string;
    image: ImageMetadata | string;
    href: string;
    class?: string;
    sizes?: string;

    overlayGradient?: boolean;
    overlayCompact?: boolean;
    cardStyle?: "overlay" | "stacked";
    mobileVariant?: "overlay" | "stacked";
    loading?: "eager" | "lazy";
    showTitle?: boolean;
}

const {
    title,
    image,
    href,
    class: className = "",
    sizes,
    overlayGradient = true,
    overlayCompact = false,
    cardStyle = "overlay",
    loading = "lazy",
    showTitle = true,
} = Astro.props;
---

<a href={href} class:list={["block group relative js-reveal reveal-hidden rounded-xl", className]}>
    <div class="relative overflow-hidden rounded-xl aspect-photo">
        <AppImage
            src={image}
            alt={title}
            width={800}
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-card-hover"
            loading={loading}
            disableAnimation={true}
            sizes={sizes}
        />

        <!-- Internal Glow Effect -->
        <div class="card-glow"></div>

        <!-- Unified Overlay (Title + Metadata) - Only if style="overlay" -->
        {cardStyle === "overlay" && (
            <div
                class:list={[
                    "absolute inset-0 flex flex-col justify-end z-20",
                    "p-4 md:p-6",
                    overlayGradient && (overlayCompact ? "bg-gradient-overlay-compact" : "bg-gradient-overlay"),
                ]}
            >
                <div class="text-white">
                    <div
                        class:list={[
                            "flex flex-wrap items-center gap-2 text-xs font-sans uppercase tracking-wider mb-2",
                            // Mobile: Visible
                            "opacity-90",
                            // Desktop: Hidden, animating in on hover
                            "md:opacity-0 md:translate-y-4 md:group-hover:opacity-100 md:group-hover:translate-y-0 md:transition-reveal",
                        ]}
                    >
                        <slot name="metadata" />
                    </div>
                    {showTitle && (
                        <h4
                            class:list={[
                                "font-serif font-light tracking-wide leading-tight text-white transition-colors duration-300 group-hover:text-mp-accent",
                                // Responsive sizing
                                "text-xl md:text-2xl",
                            ]}
                        >
                            {title}
                        </h4>
                    )}
                </div>
            </div>
        )}
    </div>

    <!-- Stacked Title (Below Image) - Only if style="stacked" -->
    {cardStyle === "stacked" && (
        <div class="mt-3 md:mt-4 space-y-2">
            {showTitle && (
                <h4 class="font-serif font-light tracking-wide leading-tight text-mp-text-heading text-lg md:text-xl transition-colors duration-300 group-hover:text-mp-accent">
                    {title}
                </h4>
            )}
            <div class="flex flex-wrap items-center gap-2 text-xs font-sans uppercase tracking-wider text-mp-text-muted">
                <slot name="metadata" />
            </div>
        </div>
    )}
</a>
