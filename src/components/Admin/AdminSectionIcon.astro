---
/**
 * Icône d'une section de la barre latérale de l'admin (tracés au trait, style Lucide).
 *
 * POURQUOI en SVG inline : la barre latérale est rendue côté serveur, sans React ni JavaScript.
 */
interface Props {
    /** Identifiant de section du registre (`contenu`, `donnees`…) ou `accueil` pour le tableau de bord. */
    name: string;
    class?: string;
}

const { name, class: className = "h-4 w-4" } = Astro.props;
---

<svg
    class={className}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
>
    {name === "accueil" && (
        <>
            <rect x="3" y="3" width="7" height="9" rx="1" />
            <rect x="14" y="3" width="7" height="5" rx="1" />
            <rect x="14" y="12" width="7" height="9" rx="1" />
            <rect x="3" y="16" width="7" height="5" rx="1" />
        </>
    )}
    {name === "contenu" && (
        <>
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="9" cy="9" r="2" />
            <path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" />
        </>
    )}
    {name === "donnees" && (
        <>
            <ellipse cx="12" cy="5" rx="9" ry="3" />
            <path d="M3 5v14a9 3 0 0 0 18 0V5" />
            <path d="M3 12a9 3 0 0 0 18 0" />
        </>
    )}
    {name === "qualite" && <path d="M22 12h-4l-3 9L9 3l-3 9H2" />}
    {name === "infra" && (
        <>
            <rect x="2" y="2" width="20" height="8" rx="2" />
            <rect x="2" y="14" width="20" height="8" rx="2" />
            <path d="M6 6h.01M6 18h.01" />
        </>
    )}
    {name === "publication" && (
        <>
            <path d="m22 2-7 20-4-9-9-4Z" />
            <path d="M22 2 11 13" />
        </>
    )}
</svg>
