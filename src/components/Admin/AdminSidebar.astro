---
/**
 * Barre latérale de l'administration.
 *
 * Responsabilité : afficher le tableau de bord puis les sections du registre (`src/config/admin-sections.ts`), chacune
 * repliable avec son icône ; seule la section de la page courante est ouverte au chargement. Les pages qui ne
 * fonctionnent pas dans le mode courant restent listées, grisées avec un badge.
 *
 * Rendu côté serveur, sans JavaScript : le repli passe par `<details>` (sur mobile, tout le menu se replie aussi,
 * voir `AdminLayout.astro`).
 * POURQUOI `block` sur les `<li>` : `base.css` met tout `<li>` en flex horizontal, ce qui alignerait l'en-tête de
 * groupe à côté de ses liens et rétrécirait les liens à leur texte.
 */
import AdminSidebarLink from "./AdminSidebarLink.astro";
import AdminSectionIcon from "./AdminSectionIcon.astro";
import {
    ADMIN_DASHBOARD,
    ADMIN_SECTIONS,
    type AdminDisplayMode,
    type AdminPage,
    type AdminPageId,
} from "@/config/admin-sections";

interface Props {
    active: AdminPageId;
    mode: AdminDisplayMode;
}

const { active, mode } = Astro.props;

/** Regroupe les pages consécutives d'un même groupe ; une page sans groupe forme une entrée seule. */
function groupPages(pages: AdminPage[]): { group?: string; pages: AdminPage[] }[] {
    const entries: { group?: string; pages: AdminPage[] }[] = [];
    for (const page of pages) {
        const last = entries[entries.length - 1];
        if (page.group && last?.group === page.group) last.pages.push(page);
        else entries.push({ group: page.group, pages: [page] });
    }
    return entries;
}

const sections = ADMIN_SECTIONS.map((section) => ({
    ...section,
    entries: groupPages(section.pages),
    isCurrent: section.pages.some((page) => page.id === active),
}));
const isDashboard = active === ADMIN_DASHBOARD.id;
---

<nav aria-label="Navigation de l'admin" class="flex flex-col gap-1 py-4 text-sm">
    <a
        href={ADMIN_DASHBOARD.href}
        aria-current={isDashboard ? "page" : undefined}
        class:list={[
            "flex min-h-touch items-center gap-3 rounded-lg px-3 transition-colors duration-200 lg:min-h-10",
            isDashboard
                ? "bg-mp-accent/15 font-semibold text-mp-accent"
                : "text-mp-text-heading mouse:hover:bg-mp-accent/10 mouse:hover:text-mp-accent",
        ]}
    >
        <AdminSectionIcon name="accueil" />
        {ADMIN_DASHBOARD.label}
    </a>

    {sections.map((section) => (
        <details open={section.isCurrent} class="group/section">
            <summary
                class:list={[
                    "flex min-h-touch cursor-pointer list-none items-center gap-3 rounded-lg px-3 transition-colors duration-200 select-none lg:min-h-10 [&::-webkit-details-marker]:hidden",
                    "font-mono text-xs tracking-wider uppercase mouse:hover:bg-mp-accent/10 mouse:hover:text-mp-accent",
                    section.isCurrent ? "text-mp-accent" : "text-mp-text-muted",
                ]}
            >
                <AdminSectionIcon name={section.id} />
                <span class="flex-1">{section.label}</span>
                <svg
                    class="h-3.5 w-3.5 transition-transform duration-200 group-open/section:rotate-90 motion-reduce:transition-none"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="m9 18 6-6-6-6" />
                </svg>
            </summary>
            <ul class="mt-0.5 mb-2 ml-5 flex flex-col gap-0.5 border-l border-mp-border pl-2">
                {section.entries.map((entry) =>
                    entry.group ? (
                        <li class="block">
                            <p class="px-3 pt-2 pb-0.5 text-xs font-semibold text-mp-text-heading">{entry.group}</p>
                            <ul class="flex flex-col gap-0.5">
                                {entry.pages.map((page) => (
                                    <li class="block">
                                        <AdminSidebarLink page={page} active={active} mode={mode} />
                                    </li>
                                ))}
                            </ul>
                        </li>
                    ) : (
                        <li class="block">
                            <AdminSidebarLink page={entry.pages[0]} active={active} mode={mode} />
                        </li>
                    ),
                )}
            </ul>
        </details>
    ))}
</nav>
