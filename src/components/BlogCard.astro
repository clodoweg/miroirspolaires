---
import type { ImageMetadata } from "astro";
import AppImage from "./UI/AppImage.astro";
import MetadataItem from "./UI/MetadataItem.astro";
import Badge from "./UI/Badge.astro";
import BlogCardMetadata from "./UI/BlogCardMetadata.astro";
import GalleryCard from "./UI/GalleryCard.astro";

interface Props {
    title: string;
    date: string;
    categories: (string | { label: string; icon?: string })[];
    description: string;
    image: ImageMetadata | string;
    href: string;
    readingTime?: string;
    datePosition?: "start" | "end";
    categoryIcon?: string;
    showMetadata?: boolean;
    showTitle?: boolean;
    variant?: "overlay" | "vertical" | "hybrid";
    mobileVariant?: "stacked" | "overlay";
    mobileLayout?: "horizontal" | "vertical";
    sizes?: string;
    overlayGradient?: boolean;
    overlayCompact?: boolean;
    cardStyle?: "overlay" | "stacked";
    loading?: "eager" | "lazy";
}

const {
    title,
    date,
    categories,
    description,
    image,
    href,
    readingTime,
    datePosition = "start",
    categoryIcon = "tag",
    showMetadata = true,
    showTitle = true,
    variant = "overlay",
    mobileLayout = "vertical",
    sizes,
    overlayGradient = true,
    overlayCompact = false,
    cardStyle = "overlay",
    loading = "lazy",
} = Astro.props;

// Shared metadata props
const metadataProps = {
    date,
    categories,
    readingTime,
    datePosition,
    categoryIcon,
};
---

{/* Overlay Variant - uses unified GalleryCard */}
{variant === "overlay" && (
    <GalleryCard
        title={title}
        image={image}
        href={href}
        sizes={sizes}
        overlayGradient={overlayGradient}
        cardStyle={cardStyle}
        loading={loading}
        showTitle={showTitle}
    >
        {showMetadata && (
            <>
                {datePosition === "start" && <MetadataItem slot="metadata" icon="calendar" label={date} />}
                {categories.map((cat) => (
                    <Badge
                        slot="metadata"
                        icon={typeof cat === "string" ? categoryIcon : cat.icon}
                        label={typeof cat === "string" ? cat : cat.label}
                    />
                ))}
                {datePosition === "end" && <MetadataItem slot="metadata" icon="calendar" label={date} />}
                {readingTime && <MetadataItem slot="metadata" icon="clock" label={readingTime} />}
            </>
        )}
    </GalleryCard>
)}

{/* Hybrid Variant (Image Overlay Metadata + Title/Desc Below) - Uses GalleryCard now */}
{variant === "hybrid" && (
    <GalleryCard
        title={title}
        image={image}
        href={href}
        sizes={sizes}
        overlayGradient={overlayGradient}
        overlayCompact={overlayCompact}
        cardStyle={cardStyle}
        loading={loading}
    >
        {showMetadata && (
            <div slot="metadata">
                <BlogCardMetadata {...metadataProps} />
            </div>
        )}
    </GalleryCard>
)}

{/* Vertical Variant (Mobile: Custom Layouts, Desktop: Hover Overlay + Desc Below) */}
{variant === "vertical" && (
    <a
        href={href}
        class:list={[
            "group relative js-reveal reveal-hidden",
            mobileLayout === "horizontal" ? "flex flex-row gap-4 items-start" : "block",
            "md:block",
        ]}
    >
        {/* Image Container + Desktop Overlay */}
        <div
            class:list={[
                "overflow-hidden rounded-xl relative",
                mobileLayout === "horizontal" ? "w-1/3 shrink-0 aspect-square" : "w-full aspect-photo mb-6",
                "md:w-full md:aspect-photo md:mb-4",
            ]}
        >
            <AppImage
                src={image}
                alt={title}
                width={800}
                sizes={sizes}
                width={800}
                sizes={sizes}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-card-hover"
                loading={loading}
            />
        </div>

        {/* Content Container */}
        <div
            class:list={[
                "flex flex-col",
                mobileLayout === "horizontal" ? "w-2/3 gap-2" : "w-full gap-3",
                "md:w-full md:gap-2",
            ]}
        >
            {/* Title (Now visible on Desktop below image) */}
            <h4
                class:list={[
                    "text-mp-text-heading font-serif leading-tight transition-colors duration-300 group-hover:text-mp-accent",
                    mobileLayout === "horizontal" ? "order-1 text-lg md:order-0 md:text-2xl" : "text-2xl",
                ]}
            >
                {title}
            </h4>

            {/* Description (Visible on both, below image on desktop) */}
            <p
                class:list={[
                    "text-mp-text-body",
                    mobileLayout === "horizontal" ? "order-3 line-clamp-5 text-sm" : "line-clamp-6",
                    "md:line-clamp-3 md:text-base md:order-0",
                ]}
            >
                {description}
            </p>
        </div>
    </a>
)}
