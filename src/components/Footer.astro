---
import { socialLinks } from "../config/social";
import { getNavItems } from "../config/navigation";
import { isBoutiqueEnabled } from "../config/shop";

interface Props {
    hasFloatingMenu?: boolean;
}

const { hasFloatingMenu = false } = Astro.props;
const activeNavItems = getNavItems();
const boutiqueActive = isBoutiqueEnabled();
---

<footer
    class:list={[
        "bg-mp-ui-black text-mp-text-primary border-t border-mp-border transition-all duration-300 shadow-floating-inverse relative z-10",
        { "footer-with-floating-menu": hasFloatingMenu },
    ]}
>
    <!-- Social Icons + Copyright -->
    <div
        class:list={[
            "container mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-12",
            hasFloatingMenu ? "pt-8 pb-24 md:pb-8" : "py-8",
        ]}
    >
        <!-- Column 1: Brand, Social & Copyright -->
        <div class="flex flex-col items-center space-y-2">
            <a href="/" class="block group">
                <img
                    src="/images/logo-mp.png"
                    alt="Miroirs Polaires"
                    width="633"
                    height="202"
                    class="h-16 w-auto object-contain brightness-0 dark:brightness-100 dark:filter-none opacity-80 group-hover:opacity-100 transition-all duration-300"
                />
            </a>

            <!-- Social Icons -->
            <div class="flex items-center gap-6">
                {socialLinks.map((link) => (
                    <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={link.name}
                        class="block w-8 h-8 text-mp-text-muted hover:text-mp-text-primary hover:scale-110 transition-all duration-300 ease-out"
                    >
                        <svg viewBox="0 0 64 64" class="w-full h-full">
                            <path fill="currentColor" d={link.path} />
                        </svg>
                    </a>
                ))}
            </div>

            <!-- Copyright -->
            <p class="text-mp-text-muted text-xs font-sans">
                © 2026 Miroirs Polaires &middot;{" "}
                <a href="/mentions-legales" class="hover:text-mp-text-primary transition-colors duration-300">
                    Mentions légales
                </a>
                {boutiqueActive && (
                    <>
                        {" "}
                        &middot;{" "}
                        <a href="/cgv" class="hover:text-mp-text-primary transition-colors duration-300">
                            CGV
                        </a>
                    </>
                )}
            </p>
        </div>

        <!-- Column 2: Quick Nav (hidden on mobile) -->
        <div class="hidden md:flex flex-col items-center md:items-start space-y-4 md:pl-20">
            <nav class="grid grid-cols-2 gap-x-12 gap-y-3 text-center md:text-left">
                {activeNavItems.map((item) =>
                    item.children ? (
                        item.children.map((child) => (
                            <a
                                href={child.href}
                                class="text-sm text-mp-text-muted hover:text-mp-text-primary hover:translate-x-1 transition-all duration-300"
                            >
                                {child.label}
                            </a>
                        ))
                    ) : (
                        <a
                            href={item.href}
                            class="text-sm text-mp-text-muted hover:text-mp-text-primary hover:translate-x-1 transition-all duration-300"
                        >
                            {item.label}
                        </a>
                    ),
                )}
            </nav>
        </div>
    </div>
</footer>
