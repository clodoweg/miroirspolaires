---
import { isAdminGranted, isLocalAdmin } from "@/lib/admin/auth/access";
import AdminLayout from "@/layouts/AdminLayout.astro";
import DatabasePanel from "@/components/Admin/DatabasePanel";

export const prerender = false;

if (!isAdminGranted(Astro.locals)) {
    return new Response("Not Found", { status: 404 });
}
const isLocal = isLocalAdmin(Astro.locals);
---

<AdminLayout title="Admin · Comètes" description="Comètes : statistiques et mise à jour." active="db-comets">
    <DatabasePanel client:only="react" view="comets" remote={!isLocal} />
</AdminLayout>
