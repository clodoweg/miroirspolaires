---
import { isAdminGranted } from "@/lib/admin/auth/access";
import AdminLayout from "@/layouts/AdminLayout.astro";
import AstroPhotosPanel from "@/components/Admin/AstroPhotosPanel";

export const prerender = false;

if (!isAdminGranted(Astro.locals)) {
    return new Response("Not Found", { status: 404 });
}
---

<AdminLayout title="Admin · Astrophotos" description="Catalogue et complétude des astrophotos." active="astrophotos">
    <AstroPhotosPanel client:only="react" />
</AdminLayout>
