---
import { isAdminGranted, isLocalAdmin } from "@/lib/admin/auth/access";
import AdminLayout from "@/layouts/AdminLayout.astro";
import VoyagesEditor from "@/components/Admin/VoyagesEditor";
import WebImagesReminder from "@/components/Admin/WebImagesReminder";
import ContentUpdatePanel from "@/components/Admin/ContentUpdatePanel";

export const prerender = false;

if (!isAdminGranted(Astro.locals)) {
    return new Response("Not Found", { status: 404 });
}
const isWritable = isLocalAdmin(Astro.locals);
---

<AdminLayout title="Admin · Voyages" description="Édition des albums voyages." active="voyages">
    {
        // POURQUOI : ces panneaux lancent des scripts locaux ; à distance, ils ne renverraient que des 501.
        isWritable && (
            <>
                <WebImagesReminder scope="voyages" client:only="react" />
                <ContentUpdatePanel scope="voyages" client:only="react" />
            </>
        )
    }
    <VoyagesEditor client:only="react" remote={!isWritable} />
</AdminLayout>
