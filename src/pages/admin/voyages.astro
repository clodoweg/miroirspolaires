---
import { isAdminGranted, isLocalAdmin } from "@/lib/admin/auth/access";
import AdminLayout from "@/layouts/AdminLayout.astro";
import VoyagesEditor from "@/components/Admin/VoyagesEditor";

export const prerender = false;

if (!isAdminGranted(Astro.locals)) {
    return new Response("Not Found", { status: 404 });
}
const isWritable = isLocalAdmin(Astro.locals);
---

<AdminLayout title="Admin · Voyages" description="Édition des albums voyages." active="voyages">
    <VoyagesEditor client:only="react" remote={!isWritable} />
</AdminLayout>
