---
import { isAdminGranted, isLocalAdmin } from "@/lib/admin/auth/access";
import AdminLayout from "@/layouts/AdminLayout.astro";
import CachePanel from "@/components/Admin/CachePanel";

export const prerender = false;

// POURQUOI : admin en local ou sur la Preview de dev seulement ; la production répond toujours 404.
if (!isAdminGranted(Astro.locals)) {
    return new Response("Not Found", { status: 404 });
}
const isLocal = isLocalAdmin(Astro.locals);
---

<AdminLayout
    title="Admin · Cache CDN & Worker"
    description="Supervision de l'état de santé du Cloudflare Worker CDN, préchauffage du cache Edge et purge globale du stockage."
    active="cache"
>
    <CachePanel client:only="react" remote={!isLocal} />
</AdminLayout>
