---
import { isAdminGranted, isLocalAdmin } from "@/lib/admin/auth/access";
import AdminLayout from "@/layouts/AdminLayout.astro";
import SEOPanel from "@/components/Admin/SEOPanel";

export const prerender = false;

if (!isAdminGranted(Astro.locals)) {
    return new Response("Not Found", { status: 404 });
}
const isLocal = isLocalAdmin(Astro.locals);
---

<AdminLayout
    title="Admin · Audit SEO"
    description="Couverture SEO, contrôles techniques et données structurées."
    active="seo"
>
    <SEOPanel client:only="react" scope="all" remote={!isLocal} />
</AdminLayout>
