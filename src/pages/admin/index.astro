---
import { isAdminGranted, isLocalAdmin } from "@/lib/admin/auth/access";
import AdminLayout from "@/layouts/AdminLayout.astro";
import Dashboard from "@/components/Admin/Dashboard";
import WebImagesReminder from "@/components/Admin/WebImagesReminder";
import { ADMIN_SECTIONS, isAdminPageAvailable } from "@/config/admin-sections";

export const prerender = false;

if (!isAdminGranted(Astro.locals)) {
    return new Response("Not Found", { status: 404 });
}

// POURQUOI : le tableau de bord complet lit src/assets et lance des scripts ; à distance, on liste
// les pages du registre qui fonctionnent à distance, groupées par section.
const isWritable = isLocalAdmin(Astro.locals);
const remoteSections = ADMIN_SECTIONS.map((section) => ({
    label: section.label,
    pages: section.pages.filter((page) => isAdminPageAvailable(page, "remote")),
})).filter((section) => section.pages.length > 0);
---

<AdminLayout title="Admin · Tableau de bord" description="Console d'administration." active="dashboard" heading>
    {isWritable ? (
        <>
            <WebImagesReminder client:only="react" />
            <Dashboard client:only="react" />
        </>
    ) : (
        <div class="flex flex-col gap-8">
            {remoteSections.map((section) => (
                <section class="flex flex-col gap-3">
                    <h2 class="font-mono text-xs tracking-wider text-mp-text-muted uppercase">{section.label}</h2>
                    <ul class="grid gap-4 sm:grid-cols-2">
                        {section.pages.map((page) => (
                            <li>
                                <a
                                    href={page.href}
                                    class="block min-h-touch rounded-md border border-mp-border px-4 py-4 mouse:hover:border-mp-border-accent"
                                >
                                    <span class="block font-semibold text-mp-text-heading">{page.label}</span>
                                    <span class="block text-sm text-mp-text-muted">{page.description}</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            ))}
        </div>
    )}
</AdminLayout>
