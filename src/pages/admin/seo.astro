---
import { isAdminGranted } from "@/lib/admin/auth/access";
import AdminLayout from "@/layouts/AdminLayout.astro";
import SEOPanel from "@/components/Admin/SEOPanel";

export const prerender = false;

if (!isAdminGranted(Astro.locals)) {
    return new Response("Not Found", { status: 404 });
}
---

<AdminLayout
    title="Admin · Bilan SEO & Référencement"
    description="Bilan de couverture des méta-descriptions seo.json, des textes alternatifs alt.json et des sitemaps."
    active="seo"
>
    <SEOPanel client:only="react" />
</AdminLayout>
