---
import { isAdminGranted } from "@/lib/admin/auth/access";
import AdminLayout from "@/layouts/AdminLayout.astro";
import R2Panel from "@/components/Admin/R2Panel";
import WebImagesReminder from "@/components/Admin/WebImagesReminder";

// Refreshed asset metadata
export const prerender = false;

if (!isAdminGranted(Astro.locals)) {
    return new Response("Not Found", { status: 404 });
}
---

<AdminLayout
    title="Admin · Cloudflare R2"
    description="Gestion et synchronisation des volumes de stockage d'images et d'assets avec Cloudflare R2."
    active="r2"
>
    <WebImagesReminder client:only="react" />
    <R2Panel client:only="react" />
</AdminLayout>
