---
/**
 * Images et textes du domaine blog : envoi sur R2, dimensions, versions web, alts et SEO manquants.
 *
 * POURQUOI une page à part : l'éditeur sert à écrire ; ce qui suit l'enregistrement (préparer les images,
 * signaler les textes à écrire via Claude Code) est un workflow distinct, qui portait auparavant sur l'en-tête
 * de l'éditeur. Les deux panneaux lancent des scripts locaux : la page est marquée `local` dans le registre.
 */
import { isAdminGranted } from "@/lib/admin/auth/access";
import AdminLayout from "@/layouts/AdminLayout.astro";
import WebImagesReminder from "@/components/Admin/WebImagesReminder";
import ContentUpdatePanel from "@/components/Admin/ContentUpdatePanel";
import ContentImagesSteps from "@/components/Admin/ContentImagesSteps.astro";

export const prerender = false;

if (!isAdminGranted(Astro.locals)) {
    return new Response("Not Found", { status: 404 });
}
---

<AdminLayout
    title="Admin · Blog · Images et textes"
    description="Images et textes du domaine blog."
    active="blog-images"
    heading
>
    <ContentImagesSteps scope="blog" />
    <WebImagesReminder scope="blog" client:only="react" />
    <ContentUpdatePanel scope="blog" client:only="react" />
</AdminLayout>
