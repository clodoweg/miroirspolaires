---
/**
 * @file src/pages/boutique.astro
 * @description Page vitrine de la boutique pour la vente du livre d'art Miroirs Polaires.
 * Présentation immersive, caractéristiques de l'ouvrage et composant d'achat interactif.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import StatsMetadata from "@/components/sections/StatsMetadata.astro";
import { BookPurchaseCard } from "@/components/Shop/BookPurchaseCard";
import { SHOP_CONFIG, isBoutiqueEnabled } from "@/config/shop";
import { BookOpen, Sparkles, Check, ShieldCheck } from "lucide-react";

export const prerender = false;

// POURQUOI : Si la variable d'environnement ENABLE_BOUTIQUE n'est pas active,
// la page boutique est inaccessible et redirige immédiatement vers la page 404.
if (!isBoutiqueEnabled()) {
    return Astro.redirect("/404");
}

const book = SHOP_CONFIG.book;
const brandId = import.meta.env.PUBLIC_MONDIAL_RELAY_BRAND_ID || "BDTEST13";
const coverImage = book.images.find((img) => img.isCover) || book.images[0];
const pageCount = parseInt(book.specs.find((spec) => spec.label === "Pagination")?.value ?? "", 10);

const headerStats = [
    { icon: "file-text", value: pageCount, label: "pages" },
    { icon: "ruler", value: "A4", label: "format" },
    { icon: "weight", value: book.weightGrams, suffix: "g", label: "poids" },
    { icon: "tag", value: book.price.toFixed(2), suffix: "€", label: "prix" },
];
---

<BaseLayout
    title="La Boutique · Livre d'Art Miroirs Polaires"
    description="Commandez le livre d'art Miroirs Polaires. 192 pages de photographies astronomiques d'exception, reliure rigide et dorure or à chaud."
    image={coverImage.src}
    breadcrumbLabel="Boutique"
>
    <PageHeader title="La Boutique" align="center">
        <Fragment slot="metadata">
            <StatsMetadata stats={headerStats} />
        </Fragment>
    </PageHeader>

    <main class="container-mp pt-4! pb-12 md:pb-16">
        <!-- Grille Principale (Présentation + Achat) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
            <!-- Colonne Gauche : Présentation du Livre & Spécifications (7 col) -->
            <div class="lg:col-span-7 space-y-8">
                <!-- Vitrine Photo / Mockup du livre -->
                <div class="relative group rounded-2xl overflow-hidden border border-mp-accent/30 bg-mp-bg-secondary shadow-hero">
                    <img
                        src={coverImage.src}
                        alt={coverImage.alt}
                        width="800"
                        height="600"
                        class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-[1.02]"
                        loading="eager"
                        fetchpriority="high"
                    />
                    {coverImage.caption && (
                        <div class="absolute bottom-0 inset-x-0 bg-linear-to-t/srgb from-black/90 via-black/50 to-transparent p-4 sm:p-6 text-xs text-mp-text-body/90 backdrop-blur-xs flex items-center justify-between">
                            <span>{coverImage.caption}</span>
                            <span class="text-mp-accent font-mono text-[11px] uppercase tracking-wider">
                                Format A4 relié
                            </span>
                        </div>
                    )}
                </div>

                <!-- Titre et Citation -->
                <div class="space-y-4">
                    <div class="flex items-center gap-2 text-xs uppercase tracking-widest text-mp-accent">
                        <Sparkles className="w-4 h-4" />
                        <span>Édition Originale Limitée</span>
                    </div>

                    <h2 class="text-2xl sm:text-3xl md:text-4xl font-serif text-mp-text-heading leading-tight">
                        {book.title}
                    </h2>

                    <p class="text-base text-mp-accent/90 italic font-serif">{book.subtitle}</p>

                    {book.quote && (
                        <blockquote class="p-4 rounded-xl border-l-2 border-mp-accent bg-mp-accent/5 text-mp-text-heading/90 italic text-sm">
                            {book.quote}
                        </blockquote>
                    )}
                </div>

                <!-- Description éditoriale -->
                <div class="space-y-4 text-sm sm:text-base text-mp-text-body leading-relaxed">
                    <p>{book.description}</p>
                </div>

                <!-- Points forts -->
                <div class="p-6 rounded-2xl border border-white/10 bg-white/5 space-y-4">
                    <h3 class="text-sm uppercase tracking-wider font-semibold text-mp-text-heading flex items-center gap-2">
                        <BookOpen className="w-4 h-4 text-mp-accent" />
                        <span>Ce que contient cet ouvrage</span>
                    </h3>
                    <ul class="space-y-2.5">
                        {book.highlights.map((highlight) => (
                            <li class="flex items-start gap-3 text-xs sm:text-sm text-mp-text-body">
                                <Check className="w-4 h-4 text-mp-accent mt-0.5 shrink-0" />
                                <span>{highlight}</span>
                            </li>
                        ))}
                    </ul>
                </div>

                <!-- Spécifications techniques détaillées -->
                <div class="space-y-4">
                    <h3 class="text-lg font-serif text-mp-text-heading">Fiche technique & Caractéristiques</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        {book.specs.map((spec) => (
                            <div class="p-3.5 rounded-xl border border-white/10 bg-mp-bg-secondary flex flex-col justify-center">
                                <span class="text-[11px] uppercase tracking-wider text-mp-text-muted">
                                    {spec.label}
                                </span>
                                <span class="text-xs sm:text-sm font-medium text-mp-text-heading mt-0.5">
                                    {spec.value}
                                </span>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <!-- Colonne Droite : Bloc de Commande Interactif & Rassurance (5 col) -->
            <div class="lg:col-span-5 space-y-6 lg:sticky lg:top-24">
                <!-- Composant React interactif de commande -->
                <BookPurchaseCard client:idle brandId={brandId} />

                <!-- Encadré d'engagement & rassurance -->
                <div class="p-5 rounded-2xl border border-white/10 bg-mp-bg-secondary/70 text-xs space-y-3.5">
                    <h4 class="font-serif text-sm text-mp-text-heading flex items-center gap-2">
                        <ShieldCheck className="w-4 h-4 text-mp-accent" />
                        <span>Engagements & Expédition</span>
                    </h4>

                    <div class="space-y-2.5 text-mp-text-muted">
                        <p class="flex items-start gap-2">
                            <span class="text-mp-accent">📦</span>
                            <span>
                                <strong>Emballage sur-mesure :</strong> livre expédié dans un étui cartonné rigide
                                renforcé pour garantir des coins impeccables.
                            </span>
                        </p>
                        <p class="flex items-start gap-2">
                            <span class="text-mp-accent">🚚</span>
                            <span>
                                <strong>Délais :</strong> expédié sous 48h ouvrées. Numéro de suivi communiqué dès le
                                départ du colis.
                            </span>
                        </p>
                        <p class="flex items-start gap-2">
                            <span class="text-mp-accent">🤝</span>
                            <span>
                                <strong>Remise en main propre :</strong> possible uniquement après accord préalable de
                                l'auteur, à obtenir avant de commander.
                            </span>
                        </p>
                        <p class="flex items-start gap-2">
                            <span class="text-mp-accent">↩️</span>
                            <span>
                                <strong>Garantie sérénité :</strong> droit légal de rétractation de 14 jours après
                                réception.
                            </span>
                        </p>
                        <p class="flex items-start gap-2">
                            <span class="text-mp-accent">✉️</span>
                            <span>
                                <strong>Une question ?</strong> Écrivez directement à l'auteur pour toute demande
                                spécifique.
                            </span>
                        </p>
                    </div>

                    <div class="pt-2 border-t border-white/10 flex justify-between items-center text-[11px]">
                        <a href="/cgv" class="text-mp-text-muted hover:text-mp-accent transition-colors underline">
                            Conditions Générales de Vente
                        </a>
                        <a href="/a-propos" class="text-mp-text-muted hover:text-mp-accent transition-colors">
                            À propos de l'auteur →
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</BaseLayout>
