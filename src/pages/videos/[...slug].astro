---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import StatsMetadata from "@/components/sections/StatsMetadata.astro";
import ContentNavigation from "@/components/ContentNavigation.astro";
import { resolveImage } from "@/utils/imageService";
import { generateVideoSchema } from "@/utils/seo";

export async function getStaticPaths() {
    const videos = await getCollection("videos");

    // Sort videos by date descending (newest first)
    videos.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

    return videos.map((entry, index) => ({
        params: { slug: entry.id },
        props: {
            entry,
            prevVideo: index + 1 < videos.length ? videos[index + 1] : null,
            nextVideo: index - 1 >= 0 ? videos[index - 1] : null,
        },
    }));
}

const { entry, prevVideo, nextVideo } = Astro.props;
const { Content } = await render(entry);

// Helper to get embed URL from watch URL or already embed
function getEmbedUrl(url: string) {
    if (url.includes("embed/")) return url;
    let videoId = "";
    if (url.includes("v=")) {
        videoId = url.split("v=")[1].split("&")[0];
    } else if (url.includes("youtu.be/")) {
        videoId = url.split("youtu.be/")[1].split("?")[0];
    }
    return `https://www.youtube.com/embed/${videoId}`;
}

const embedUrl = getEmbedUrl(entry.data.videoUrl);

// Resolve video thumbnail for Open Graph
const resolvedImage = resolveImage(entry.data.image);
const imageSrc = typeof resolvedImage === "string" ? resolvedImage : resolvedImage?.src;

const videoSchema = generateVideoSchema(entry, imageSrc);

const headerStats = [
    { icon: "calendar", value: entry.data.date, label: "Publié le" },
    ...(entry.data.categories || []).map((c: string) => ({
        icon: "tag",
        value: c,
        label: "Catégorie",
    })),
];
import MobileFloatingMenu from "@/components/MobileFloatingMenu.astro";
---

<BaseLayout
    title={entry.data.title}
    description={
        entry.data.description ||
        `Découvrez la vidéo "${entry.data.title}" sur l'astronomie, l'astrophotographie et l'observation céleste.`
    }
    image={resolvedImage}
    breadcrumbLabel={entry.data.title}
    hasFloatingMenu={true}
>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={videoSchema} />
    </Fragment>

    <PageHeader title={entry.data.title} align="center">
        <Fragment slot="metadata">
            <StatsMetadata stats={headerStats} />
        </Fragment>
    </PageHeader>

    <article class="container-mp pb-6 md:pb-0 pt-0 -mt-2">
        <div class="max-w-screen-lg mx-auto">
            {/* Markdown content */}
            <div class="prose prose-lg prose-slate prose-headings:text-mp-text-heading prose-strong:text-mp-text-heading max-w-none mx-auto prose-headings:font-serif prose-headings:font-normal prose-h2:text-3xl md:prose-h2:text-4xl prose-h2:mt-12 prose-h2:mb-6 prose-img:rounded-lg prose-p:text-mp-text-body mb-12">
                <Content />
            </div>

            {/* Video Embed */}
            <div class="rounded-lg overflow-hidden shadow-lg aspect-video bg-mp-ui-black mb-16">
                <iframe
                    width="100%"
                    height="100%"
                    src={embedUrl}
                    title={entry.data.title}
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                ></iframe>
            </div>
        </div>

        <ContentNavigation
            prev={
                prevVideo
                    ? {
                          url: `/videos/${prevVideo.id}`,
                          title: prevVideo.data.title,
                      }
                    : undefined
            }
            next={
                nextVideo
                    ? {
                          url: `/videos/${nextVideo.id}`,
                          title: nextVideo.data.title,
                      }
                    : undefined
            }
            prevLabel="Vidéo précédente"
            nextLabel="Vidéo suivante"
            class="mt-0"
        />
    </article>
    <MobileFloatingMenu
        prevUrl={prevVideo ? `/videos/${prevVideo.id}` : undefined}
        nextUrl={nextVideo ? `/videos/${nextVideo.id}` : undefined}
        galleryUrl="/videos"
    />
</BaseLayout>
