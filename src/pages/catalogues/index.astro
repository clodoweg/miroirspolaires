---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import StatsMetadata from "@/components/sections/StatsMetadata.astro";
import { CATALOGUES } from "@/lib/catalogues/registry";
import seoData from "@/data/seo.json";

const totalObjects = CATALOGUES.reduce((sum, c) => sum + c.count, 0);

const headerStats = [
    { icon: "file-text", value: CATALOGUES.length, label: "Catalogues" },
    { icon: "star", value: totalObjects.toLocaleString("fr-FR"), label: "Objets indexés" },
];

const description =
    (seoData as Record<string, string>)["catalogues/index"] ||
    "Les grands catalogues d'objets du ciel profond — Messier, Caldwell, NGC, IC, Sharpless, Lynds, Barnard, ...";
---

<BaseLayout title="Catalogues du ciel" description={description} breadcrumbLabel="Catalogues">
    <main class="container-mp pb-16">
        <PageHeader title="Catalogues du ciel profond">
            <Fragment slot="metadata">
                <StatsMetadata stats={headerStats} />
            </Fragment>
        </PageHeader>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {CATALOGUES.map((c) => (
                <a
                    href={`/catalogues/${c.slug}`}
                    class="group rounded-xl border border-mp-glass-border bg-mp-glass-solid p-6 space-y-3 hover:border-mp-accent transition-colors no-underline"
                >
                    <div class="flex items-baseline justify-between gap-3">
                        <h2 class="text-xl text-mp-text-heading group-hover:text-mp-accent transition-colors">
                            {c.shortName}
                        </h2>
                        <span class="text-xs uppercase tracking-wide text-mp-text-muted font-mono">{c.epoch}</span>
                    </div>
                    <p class="text-xs uppercase tracking-uppercase text-mp-accent">{c.tagline}</p>
                    <p class="text-sm text-mp-text-body line-clamp-4">{c.description}</p>
                    <div class="pt-3 border-t border-mp-glass-border flex items-center justify-between text-xs text-mp-text-muted">
                        <span class="font-mono">{c.count.toLocaleString("fr-FR")} objets</span>
                        <span class="group-hover:text-mp-accent transition-colors">Parcourir →</span>
                    </div>
                </a>
            ))}
        </div>
    </main>
</BaseLayout>
